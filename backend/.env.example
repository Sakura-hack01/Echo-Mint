# ============================================
# EchoMint Backend Configuration
# Copy this file to backend/.env and fill in the keys you want to use.
# All keys are optional: without keys, EchoMint runs in built-in Demo Mode
# so you can still test the full chat -> art -> preview -> NEAR mint flow.
# ============================================

PORT=3001

# --- 1. AI Chat & Prompt Co-Pilot (pick ONE, Gemini is checked first) ---
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or use OpenAI (also enables OpenAI DALL-E / gpt-image-1 image generation)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- 2. AI Image Generation (optional alternatives if not using OpenAI/Gemini) ---
# Stability AI: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Hugging Face Inference API: https://huggingface.co/settings/tokens
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- 3. IPFS Pinning (Pinata) ---
# Get a free JWT at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
